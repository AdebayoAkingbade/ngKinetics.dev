{
  "name": "angularmotion.dev",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "docs:check": "tsc -b apps/docs --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint .",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "security:check": "npm run lint && npm run typecheck && npm test && npm run security:audit:prod",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-browser-dynamic": "22.1.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@angular/compiler": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "happy-dom": "20.12.0",
    "ng-packagr": "22.2.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
